  "normalization": {
    "exact_runtime_root": {
      "replacement": "<ORACLE_ROOT>",
      "scope": [
        "argv",
        "stdout",
        "stderr",
        "manifest_roots",
        "artifact_evidence"
      ],
      "rule": "replace only the exact unique mktemp-owned runtime root"
    }
  },
  "server": {
    "command": [
      "mcp",
      "--host",
      "127.0.0.1",
      "--port",
      "<PORT>"
    ],
    "bind": "127.0.0.1",
    "port": "<PORT>",
    "auth_token": "<MCP_TOKEN>"
  },
