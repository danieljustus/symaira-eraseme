    "go_root": "<GO_ROOT>",
    "module_cache": "<PINNED_MODULE_CACHE>",
    "goproxy": "off",
    "goenv": "off",
    "gowork": "off",
    "gotoolchain": "go1.26.6",
    "cache": "isolated",
    "home": "isolated"
