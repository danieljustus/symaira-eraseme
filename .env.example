# Symaira EraseMe environment configuration
# Released binaries use these values for local data, providers, and consent.
# Keep resolved credentials out of this file; use symvault:// references or the
# platform secure store where the command supports them.

# Shared LLM provider used for reply classification and rebuttals.
SYMERASEME_LLM_PROVIDER=shared
# SYMERASEME_LLM_MODEL=provider-model
# ANTHROPIC_API_KEY=use-a-secure-reference
# OPENAI_API_KEY=use-a-secure-reference

# Local event-store and identity locations.
SYMERASEME_DATA_DIR=~/.local/share/symeraseme
SYMERASEME_DB_DIR=~/.local/share/symeraseme
SYMERASEME_IDENTITY_PATH=~/.local/share/symeraseme/identity.encrypted
# SYMERASEME_RESOURCES=/path/to/custom/registry
# SYMERASEME_BIN=/opt/homebrew/bin/symeraseme

# MCP HTTP defaults. Non-loopback binds require --allow-remote.
# SYMERASEME_MCP_HOST=127.0.0.1
# SYMERASEME_MCP_PORT=8000

# Consent for destructive operations. Prefer a 0600 consent file for automation.
# SYMERASEME_CONSENT=short-lived-token
# SYMERASEME_CONSENT_FILE=~/.local/share/symeraseme/consent.token

# Encrypt the SQLite database at rest with standard Fernet (AES-128-CBC + HMAC-SHA256).
# SYMERASEME_ENCRYPT_DB=1

# IMAP inbox polling (optional).
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USERNAME=user@example.com
# IMAP_PASSWORD=symvault://email/imap-password
# IMAP_OAUTH2_USERNAME=user@example.com
# IMAP_OAUTH2_ACCESS_TOKEN=symvault://oauth2/user@example.com/access_token
# IMAP_FOLDER=INBOX

# SMTP batch sending (optional).
# SYMERASEME_SMTP_HOST=smtp.example.com
# SYMERASEME_SMTP_PORT=587
# SYMERASEME_SMTP_USER=user@example.com
# SYMERASEME_SMTP_PASSWORD=symvault://email/smtp-password
# SYMERASEME_SMTP_FROM=user@example.com
# SYMERASEME_SMTP_TLS=1

# Optional CAPTCHA provider reference for supported web forms.
# CAPSOLVER_API_KEY=symvault://captcha/capsolver
