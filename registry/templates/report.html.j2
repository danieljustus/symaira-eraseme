<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Campaign Report{% if data.campaigns %} — {{ data.campaigns[0].campaign_id }}{% endif %}</title>
<style>
/* Symaira Liquid Topography. Local fonts only: opening this file makes no network request. */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  color-scheme: light dark;
  --canvas: #EEEDEA;
  --surface: #E1E0DA;
  --raised: #EEEDEA;
  --line: #B0AEA9;
  --ink: #141413;
  --ink-2: #2B2B2A;
  --ink-3: #62615D;
  --positive: #34694A;
  --critical: #9A4634;
}

@media (prefers-color-scheme: dark) {
  :root {
    --canvas: #1C1C1B;
    --surface: #141413;
    --raised: #2B2B2A;
    --line: #30302E;
    --ink: #EEEDEA;
    --ink-2: #B0AEA9;
    --ink-3: #97958F;
    --positive: #93C49F;
    --critical: #E39C8A;
  }
}

body {
  font-family: "Google Sans Flex", "Google Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-variant-numeric: tabular-nums;
  background: var(--canvas);
  color: var(--ink);
  line-height: 1.5;
  padding: 24px 16px 48px;
  -webkit-font-smoothing: antialiased;
}
.container { max-width: 1008px; margin: 0 auto; }
h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; }
.subtitle { color: var(--ink-3); font-size: 0.8125rem; margin: 4px 0 24px; }
h2 { font-size: 1.0625rem; font-weight: 700; margin: 28px 0 12px; }
h3 { font-size: 0.6875rem; font-weight: 700; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.08em; margin: 16px 0 8px; }
.meta { font-size: 0.8125rem; color: var(--ink-3); margin-bottom: 12px; }

.metrics-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; margin-bottom: 12px; }
.metric-card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 12px 14px; display: flex; flex-direction: column; gap: 4px; }
.metric-card .value { font-size: 1.375rem; font-weight: 700; line-height: 1.1; }
.metric-card .label { font-size: 0.6875rem; font-weight: 700; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.08em; }
.metric-card .change { font-size: 0.75rem; font-weight: 600; }
.change.positive { color: var(--positive); }
.change.negative { color: var(--critical); }

.table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); margin-bottom: 12px; }
table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; }
th, td { padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--line); }
th { font-size: 0.6875rem; font-weight: 700; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.08em; }
tr:last-child td { border-bottom: none; }
.details { font-size: 0.75rem; color: var(--ink-2); }

.error { border: 1px solid var(--critical); color: var(--critical); background: var(--surface); padding: 12px 14px; border-radius: 10px; margin-bottom: 16px; }
.empty, .note { color: var(--ink-3); font-size: 0.8125rem; }
.footer { margin-top: 32px; font-size: 0.75rem; color: var(--ink-3); text-align: center; }

@media print {
  body { background: #FFFFFF; padding: 0; }
}
</style>
</head>
<body>
<div class="container">
  <h1>Campaign Report</h1>
  <p class="subtitle">
    Generated {{ now.strftime("%Y-%m-%d %H:%M UTC") }}
    &middot; {{ data.total_requests }} requests
    &middot; {{ data.total_campaigns }} campaign(s)
  </p>

  {% if data.get("error") %}
  <div class="error">{{ data.error }}</div>
  {% endif %}

  {% set sm = data.success_metrics %}
  {% if sm %}
  <h2>Success Metrics</h2>
  <div class="metrics-grid">
    <div class="metric-card"><div class="label">Confirmation Rate</div><div class="value">{{ sm.overall_confirmation_rate }}%</div></div>
    <div class="metric-card"><div class="label">Rejection Rate</div><div class="value">{{ sm.overall_rejection_rate }}%</div></div>
    <div class="metric-card"><div class="label">Overdue Rate</div><div class="value">{{ sm.overdue_rate }}%</div></div>
    <div class="metric-card"><div class="label">Avg Response (days)</div><div class="value">{{ sm.avg_response_time_days or "—" }}</div></div>
    <div class="metric-card"><div class="label">Median Response (days)</div><div class="value">{{ sm.median_response_time_days or "—" }}</div></div>
  </div>
  {% endif %}

  {% if data.historical_comparison %}
  {% set hc = data.historical_comparison %}
  <h2>Historical Comparison</h2>
  <div class="metrics-grid">
    <div class="metric-card"><div class="label">Request Change</div><div class="value">{{ hc.requests_change }}</div></div>
    <div class="metric-card">
      <div class="label">Confirmation Rate Change</div>
      <div class="value">{{ hc.confirmation_rate_change }}%</div>
      <div class="change {{ 'positive' if hc.confirmation_rate_change >= 0 else 'negative' }}">{{ "↑" if hc.confirmation_rate_change >= 0 else "↓" }}</div>
    </div>
    <div class="metric-card">
      <div class="label">Rejection Rate Change</div>
      <div class="value">{{ hc.rejection_rate_change }}%</div>
      <div class="change {{ 'positive' if hc.rejection_rate_change <= 0 else 'negative' }}">{{ "↑" if hc.rejection_rate_change > 0 else "↓" }}</div>
    </div>
  </div>
  {% endif %}

  {% for camp in data.campaigns %}
  <h2>Campaign: {{ camp.campaign_id }}</h2>
  <p class="meta">
    {{ camp.kind }} &middot; Created {{ camp.created_at[:10] if camp.created_at else "?" }}
    &middot; {{ camp.total }} requests
    &middot; {{ camp.confirmation_rate }}% confirmed
  </p>
  <div class="metrics-grid">
    <div class="metric-card"><div class="label">Planned</div><div class="value">{{ camp.planned }}</div></div>
    <div class="metric-card"><div class="label">Sent</div><div class="value">{{ camp.sent }}</div></div>
    <div class="metric-card"><div class="label">Awaiting Ack</div><div class="value">{{ camp.awaiting_ack }}</div></div>
    <div class="metric-card"><div class="label">Awaiting Response</div><div class="value">{{ camp.awaiting_response }}</div></div>
    <div class="metric-card"><div class="label">Confirmed</div><div class="value">{{ camp.confirmed }}</div></div>
    <div class="metric-card"><div class="label">Rejected</div><div class="value">{{ camp.rejected }}</div></div>
    <div class="metric-card"><div class="label">Overdue</div><div class="value">{{ camp.overdue }}</div></div>
    <div class="metric-card"><div class="label">Reminders</div><div class="value">{{ camp.total_reminders_sent }}</div></div>
    <div class="metric-card"><div class="label">Avg Response (days)</div><div class="value">{{ camp.avg_response_time_days or "—" }}</div></div>
  </div>

  <h3>Requests</h3>
  {% if camp.requests %}
  <div class="table-wrap">
  <table>
    <thead>
      <tr><th>ID</th><th>Broker</th><th>Jurisdiction</th><th>Status</th><th>Sent</th><th>Resolved</th><th>Reminders</th></tr>
    </thead>
    <tbody>
      {% for req in camp.requests[:100] %}
      <tr>
        <td>#{{ req.id }}</td>
        <td>{{ req.broker_id }}</td>
        <td>{{ req.jurisdiction }}</td>
        <td>{{ req.current_status }}</td>
        <td>{{ (req.sent_at or "")[:10] }}</td>
        <td>{{ (req.resolved_at or "")[:10] }}</td>
        <td>{{ req.reminders_sent }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% if camp.requests|length > 100 %}
  <p class="note">Showing first 100 of {{ camp.requests|length }} requests.</p>
  {% endif %}
  {% else %}
  <p class="empty">No requests in this campaign.</p>
  {% endif %}
  {% endfor %}

  {% if data.broker_leaderboard %}
  <h2>Broker Leaderboard</h2>
  <div class="table-wrap">
  <table>
    <thead>
      <tr><th>Broker</th><th>Total</th><th>Confirmed</th><th>Rejected</th><th>Overdue</th><th>Success Rate</th><th>Avg Response</th></tr>
    </thead>
    <tbody>
      {% for b in data.broker_leaderboard %}
      <tr>
        <td><strong>{{ b.broker_id }}</strong></td>
        <td>{{ b.total }}</td>
        <td>{{ b.confirmed }}</td>
        <td>{{ b.rejected }}</td>
        <td>{{ b.overdue }}</td>
        <td>{{ b.success_rate }}%</td>
        <td>{{ b.avg_response_time_days or "—" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}

  {% if data.jurisdiction_stats %}
  <h2>Jurisdiction Breakdown</h2>
  <div class="table-wrap">
  <table>
    <thead>
      <tr><th>Jurisdiction</th><th>Total</th><th>Confirmed</th><th>Rejected</th><th>Overdue</th><th>Confirmation Rate</th></tr>
    </thead>
    <tbody>
      {% for j in data.jurisdiction_stats %}
      <tr>
        <td><strong>{{ j.jurisdiction }}</strong></td>
        <td>{{ j.total }}</td>
        <td>{{ j.confirmed }}</td>
        <td>{{ j.rejected }}</td>
        <td>{{ j.overdue }}</td>
        <td>{{ j.confirmation_rate }}%</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}

  {% if data.timeline %}
  <h2>Timeline</h2>
  <div class="table-wrap">
  <table>
    <thead>
      <tr><th>Date</th><th>Events</th><th>Details</th></tr>
    </thead>
    <tbody>
      {% for t in data.timeline %}
      <tr>
        <td>{{ t.date }}</td>
        <td>{{ t.total_events }}</td>
        <td class="details">{% if t.events is mapping %}{% for kind, count in t.events|items %}{{ kind }} ×{{ count }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}{{ t.events|join(", ") }}{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}

  <div class="footer">Generated by Symaira EraseMe &middot; {{ now.strftime("%Y-%m-%d %H:%M UTC") }}</div>
</div>
</body>
</html>
