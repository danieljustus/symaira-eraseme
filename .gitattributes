# Generated encrypted interoperability fixtures are binary.
tests/fixtures/identity-contract/*.enc binary
tests/fixtures/event-store/crypto/*.db binary

# Embedded completion scripts have byte-exact Go/Rust golden contracts.
crates/symeraseme-cli/src/commands/completion/*.txt text eol=lf

# Canonical templates are rendered against byte-exact cross-platform goldens.
registry/laws/** text eol=lf
registry/templates/** text eol=lf

# Go sources are read by rust-tests/parity/oracle/*/main.go and hashed
# against a pinned sourceSHA256 provenance constant (verifySourceHash). A
# Windows checkout with the platform's common core.autocrlf=true default
# rewrites LF to CRLF, changing the hash and making the oracle exit non-zero
# with no visible diagnostic in the Rust test's panic message beyond "exited
# unsuccessfully" (frozen_fixture_matches_live_go_oracle in
# scheduler_parity.rs). Force LF unconditionally so every checkout — and
# every future oracle's pinned hash — sees the same bytes as `git blame`.
*.go text eol=lf

# Profile oracle helper provenance is byte-hashed on native Windows too.
rust-tests/parity/profile_read.py text eol=lf
rust-tests/parity/oracle/profile_read/cases.json text eol=lf

# MCP contract fixtures are included with include_bytes! and compared
# byte-for-byte against generated responses. A Windows checkout with the
# platform default core.autocrlf=true rewrites the trailing LF to CRLF and the
# comparison then fails on Windows only, while every Unix gate stays green.
tests/fixtures/mcp-contract/** text eol=lf

# Migration oracle inputs and generator identities are byte-hashed on Windows.
rust-tests/parity/oracle/migration-state/** text eol=lf
rust-tests/parity/oracle/migration-safety/** text eol=lf
