{"dry_run":true,"files":{"crontab.txt":"# Symaira EraseMe scheduled tasks\n# Generated by symeraseme generate-scheduler (Go)\n\n# Tick (daily at 10:00)\n0 10 * * * {wrapper_dir}/symeraseme-tick.sh\n\n# Poll inbox (hourly wrapper checks configured times)\n0 * * * * {wrapper_dir}/symeraseme-poll.sh\n\n# Re-scan (quarterly on 1st of Jan, Apr, Jul, Oct)\n0 10 1 1,4,7,10 * {wrapper_dir}/symeraseme-rescan.sh\n\n# End Symaira EraseMe scheduled tasks\n","install.sh":"#!/usr/bin/env bash\nset -euo pipefail\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" \u0026\u0026 pwd)\"\nchmod +x \"$SCRIPT_DIR\"/*.sh\nTEMP=$(mktemp)\ntrap 'rm -f \"$TEMP\"' EXIT\n(crontab -l 2\u003e/dev/null || true) | awk '\n  /^# Symaira EraseMe scheduled tasks$/ { skip=1; next }\n  /^# End Symaira EraseMe scheduled tasks$/ { skip=0; next }\n  skip { next }\n  { print }\n' \u003e \"$TEMP\"\nsed \"s|{wrapper_dir}|$SCRIPT_DIR|g\" \"$SCRIPT_DIR/crontab.txt\" \u003e\u003e \"$TEMP\"\ncrontab \"$TEMP\"\nprintf 'Crontab installed. Wrappers in: %s\\n' \"$SCRIPT_DIR\"\n","symeraseme-poll.sh":"#!/usr/bin/env bash\n# Symaira EraseMe scheduled inbox poll wrapper\n# Generated by symeraseme generate-scheduler (Go)\nset -euo pipefail\n\nexport SYMERASEME_HEADLESS=1\ncd '<ORACLE_ROOT>\\cli\\operate-schedule-install\\cwd'\n\nCURRENT_HHMM=$(date +%H:%M)\ncase \"$CURRENT_HHMM\" in\n08:00|12:00|16:00|20:00)\n    exec '<GO_ORACLE_BIN>' poll-inbox --output json\n    ;;\nesac\n","symeraseme-rescan.sh":"#!/usr/bin/env bash\n# Symaira EraseMe scheduled task wrapper\n# Generated by symeraseme generate-scheduler (Go)\nset -euo pipefail\n\nexport SYMERASEME_HEADLESS=1\ncd '<ORACLE_ROOT>\\cli\\operate-schedule-install\\cwd'\n\nexec '<GO_ORACLE_BIN>' 'tick' '--output' 'json' '--dry-run'\n","symeraseme-tick.sh":"#!/usr/bin/env bash\n# Symaira EraseMe scheduled task wrapper\n# Generated by symeraseme generate-scheduler (Go)\nset -euo pipefail\n\nexport SYMERASEME_HEADLESS=1\ncd '<ORACLE_ROOT>\\cli\\operate-schedule-install\\cwd'\n\nexec '<GO_ORACLE_BIN>' 'tick' '--output' 'json'\n","uninstall.sh":"#!/usr/bin/env bash\nset -euo pipefail\nTEMP=$(mktemp)\ntrap 'rm -f \"$TEMP\"' EXIT\n(crontab -l 2\u003e/dev/null || true) | awk '\n  /^# Symaira EraseMe scheduled tasks$/ { skip=1; next }\n  /^# End Symaira EraseMe scheduled tasks$/ { skip=0; next }\n  skip { next }\n  { print }\n' \u003e \"$TEMP\"\ncrontab \"$TEMP\"\nprintf '%s\\n' 'Symaira EraseMe entries removed from crontab.'\n"},"success":true}
