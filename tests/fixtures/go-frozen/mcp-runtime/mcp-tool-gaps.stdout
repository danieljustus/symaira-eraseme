 \\\\u003c/div\\\\u003e\\\\n\\\\n  \\\\u003c!-- Broker status grid --\\\\u003e\\\\n  \\\\u003cdiv class=\\\\\\\"section\\\\\\\"\\\\u003e\\\\n    \\\\u003cdiv class=\\\\\\\"section-title-bar\\\\\\\"\\\\u003e\\\\n      \\\\u003ch2 class=\\\\\\\"section-title\\\\\\\"\\\\u003eBroker Status\\\\u003c/h2\\\\u003e\\\\n      \\\\n      \\\\u003cdiv class=\\\\\\\"filter-controls\\\\\\\"\\\\u003e\\\\n        \\\\u003cdiv class=\\\\\\\"search-input-wrapper\\\\\\\"\\\\u003e\\\\n          \\\\u003cinput type=\\\\\\\"text\\\\\\\" class=\\\\\\\"search-input\\\\\\\" id=\\\\\\\"broker-search\\\\\\\" placeholder=\\\\\\\"Search data brokers...\\\\\\\" oninput=\\\\\\\"handleSearch(this.value)\\\\\\\"\\\\u003e\\\\n        \\\\u003c/div\\\\u003e\\\\n        \\\\u003cdiv class=\\\\\\\"filter-btn-group\\\\\\\"\\\\u003e\\\\n          \\\\u003cbutton class=\\\\\\\"filter-btn active\\\\\\\" onclick=\\\\\\\"setFilter('all', this)\\\\\\\"\\\\u003eAll\\\\u003c/button\\\\u003e\\\\n          \\\\u003cbutton class=\\\\\\\"filter-btn\\\\\\\" onclick=\\\\\\\"setFilter('confirmed', this)\\\\\\\"\\\\u003eConfirmed\\\\u003c/button\\\\u003e\\\\n          \\\\u003cbutton class=\\\\\\\"filter-btn\\\\\\\" onclick=\\\\\\\"setFilter('pending', this)\\\\\\\"\\\\u003ePending\\\\u003c/button\\\\u003e\\\\n          \\\\u003cbutton class=\\\\\\\"filter-btn\\\\\\\" onclick=\\\\\\\"setFilter('overdue', this)\\\\\\\"\\\\u003eOverdue\\\\u003c/button\\\\u003e\\\\n          \\\\u003cbutton class=\\\\\\\"filter-btn\\\\\\\" onclick=\\\\\\\"setFilter('rejected', this)\\\\\\\"\\\\u003eRejected\\\\u003c/button\\\\u003e\\\\n        \\\\u003c/div\\\\u003e\\\\n      \\\\u003c/div\\\\u003e\\\\n    \\\\u003c/div\\\\u003e\\\\n\\\\n    \\\\u003cp style=\\\\\\\"color: var(--text-muted); font-size: 0.85rem;\\\\\\\"\\\\u003eNo broker data available.\\\\u003c/p\\\\u003e\\\\n  \\\\u003c/div\\\\u003e\\\\n\\\\n  \\\\u003c!-- Recent events --\\\\u003e\\\\n  \\\\u003cdiv class=\\\\\\\"card section\\\\\\\"\\\\u003e\\\\n    \\\\u003cdiv class=