nfor marketing opt-outs, as it persists across database updates.\\\\n\\\"},{\\\"id\\\":\\\"bisnode-eu\\\",\\\"name\\\":\\\"Bisnode (Dun \\\\u0026 Bradstreet)\\\",\\\"website\\\":\\\"https://www.bisnode.com\\\",\\\"category\\\":\\\"analytics\\\",\\\"jurisdictions\\\":[\\\"SE\\\",\\\"NO\\\",\\\"DK\\\",\\\"FI\\\",\\\"DE\\\",\\\"EU\\\"],\\\"laws\\\":[\\\"GDPR\\\"],\\\"data_sensitivity\\\":4,\\\"priority\\\":\\\"medium\\\",\\\"opt_out\\\":[{\\\"type\\\":\\\"email\\\",\\\"endpoint\\\":\\\"privacy@bisnode.com\\\",\\\"template\\\":\\\"gdpr-art17\\\",\\\"locale\\\":\\\"en\\\",\\\"required_fields\\\":[\\\"full_name\\\",\\\"address\\\",\\\"email\\\",\\\"date_of_birth\\\"],\\\"supports_suppression\\\":false,\\\"expected_response_days\\\":30}],\\\"verification\\\":{\\\"ack_keywords\\\":[\\\"received\\\",\\\"request\\\",\\\"erasure\\\"],\\\"rejection_keywords\\\":[\\\"cannot process\\\",\\\"legitimate interests\\\"],\\\"human_required_keywords\\\":[\\\"identity verification\\\",\\\"documentation\\\"]},\\\"added_date\\\":\\\"2025-05-21\\\",\\\"status\\\":\\\"active\\\",\\\"notes\\\":\\\"Bisnode was a Nordic/European data analytics company, now fully rebranded\\\\nunder Dun \\\\u0026 Bradstreet after the 2021 acquisition. They provide B2B and\\\\nB2C data across the Nordics and DACH region. Contact their regional\\\\nDPA-registered offices for jurisdiction-specific requests.\\\\n\\\"},{\\\"id\\\":\\\"boniversum-eu\\\",\\\"name\\\":\\\"Boniversum (Arvato Financial Solutions)\\\",\\\"website\\\":\\\"https://www.boniversum.de\\\",\\\"category\\\":\\\"credit\\\",\\\"jurisdictions\\\":[\\\"DE\\\",\\\"EU\\\"],\\\"laws\\\":[\\\"GDPR\\\"],\\\"data_sensitivity\\\":5,\\\"priority\\\":\\\"high\\\",\\\"opt_out\\\":[{\\\"type\\\":\\\"email\\\",\\\"endpoint\\\":\\\"datenschutz@boniversum.de\\\",\\\"template\\\":\\\"gdpr-art17\\\",\\\"locale\\\":\\\"de\\\",\\\"required_fields\\\":[\\\"full_name\\\",\\\"address\\\",\\\"email\\\",\\\"date_of_birth\\\"],\\\"supports_suppression\\\":false,\\\"expected_response_days\\\":30}],\\\"verification\\\":{\\\"ack_keywords\\\":[\\\"bestätigen\\\",\\\"eingang\\\",\\\"löschung\\\"],\\\"rejection_keywords\\\":[\\\"nicht möglich\\\",\\\"berechtigtes interesse\\\"],\\\"human_required_keywords\\\":[\\\"ausweis\\\",\\\"identitätsnachweis\\\"]},\\\"added_date\\\":\\\"2025-05-21\\\",\\\"status\\\":\\\"active\\\",\\\"notes\\\":\\\"Boniversum is Arvato Financial Solutions' consumer credit reporting\\\\nservice, a subsidiary of Bertelsmann. They provide creditworthiness\\\\ndata to German banks, telecoms, and insurance companies.\\\\nConsumer self-inquiries are free once per year under GDPR Art. 15.\\\\n\\\"},{\\\"id\\\":\\\"creditreform-eu\\\",\\\"name\\\":\\\"Creditreform\\\",\\\"website\\\":\\\"https://www.creditreform.de\\\",\\\"category\\\":\\\"credit\\\",\\\"jurisdictions\\\":[\\\"DE\\\",\\\"AT\\\",\\\"CH\\\",\\\"EU\\\"],\\\"laws\\\":[\\\"GDPR\\\"],\\\"data_sensitivity\\\":5,\\\"priority\\\":\\\"high\\\",\\\"opt_out\\\":[{\\\"type\\\":\\\"email\\\",\\\"endpoint\\\":\\\"datenschutz@verband.creditreform.de\\\",\\\"template\\\":\\\"gdpr-art17\\\",\\\"locale\\\":\\\"de\\\",\\\"required_fields\\\":[\\\"full_name\\\",\\\"address\\\",\\\"email\\\",\\\"date_of_birth\\\"],\\\"supports_suppression\\\":false,\\\"expected_response_days\\\":30}],\\\"verification\\\":{\\\"ack_keywords\\\":[\\\"bestätigen\\\",\\\"erhalten\\\",\\\"vorgangsnummer\\\",\\\"löschung\\\"],\\\"rejection_keywords\\\":[\\\"nicht verifizieren\\\",\\\"weitere Angaben erforderlich\\\"],\\\"human_required_keywords\\\":[\\\"ausweis\\\",\\\"identitätsnachweis\\\",\\\"legitimation\\\"]},\\\"added_date\\\":\\\"2025-05-21\\\",\\\"status\\\":\\\"active\\\",\\\"notes\\\":\\\"Creditreform is Germany's largest business credit reporting network\\\\nwith over 130 member companies. They maintain data on both businesses\\\\nand private individuals. Art. 17 GDPR deletion requests may be partially\\\\nrejected if data is required for legitimate creditor interests — in that\\\\ncase, request Art. 21 restriction of processing instead.\\\\nLocal member offices may need to be contacted separately.\\\\n\\\"},{\\\"id\\\":\\\"crif-eu\\\",\\\"name\\\":\\\"CRIF GmbH (Bürgel)\\\",\\\"website\\\":\\\"https://www.crif.de\\\",\\\"category\\\":\\\"credit\\\",\\\"jurisdictions\\\":[\\\"DE\\\",\\\"AT\\\",\\\"EU\\\"],\\\"laws\\\":[\\\"GDPR\\\"],\\\"data_sensitivity\\\":5,\\\"priority\\\":\\\"high\\\",\\\"opt_out\\\":[{\\\"type\\\":\\\"email\\\",\\\"endpoint\\\":\\\"datenschutz@crif.de\\\",\\\"template\\\":\\\"gdpr-art17\\\",\\\"locale\\\":\\\"de\\\",\\\"required_fields\\\":[\\\"full_name\\\",\\\"address\\\",\\\"email\\\",\\\"date_of_birth\\\"],\\\"supports_suppression\\\":false,\\\"expected_response_days\\\":30},{\\\"type\\\":\\\"web_form\\\",\\\"url\\\":\\\"https://www.crif.de/verbraucher/datenschutz/\\\",\\\"form_spec\\\":{\\\"steps\\\":[{\\\"goto\\\":\\\".\\\"},{\\\"fill\\\":{\\\"input[name=email]\\\":\\\"${email}\\\",\\\"input[name=geburtsdatum]\\\":\\\"${date_of_birth}\\\",\\\"input[name=nachname]\\\":\\\"${last_name}\\\",\\\"input[name=ort]\\\":\\\"${city}\\\",\\\"input[name=plz]\\\":\\\"${postal_code}\\\",\\\"input[name=strasse]\\\":\\\"${address}\\\",\\\"input[name=vorname]\\\":\\\"${first_name}\\\"}},{\\\"click\\\":\\\"button[type=submit]\\\"},{\\\"wait_for\\\":\\\".success\\\"},{\\\"screenshot\\\":\\\"result\\\"}],\\\"timeout_seconds\\\":45,\\\"rate_limit_delay\\\":3}}],\\\"verification\\\":{\\\"ack_keywords\\\":[\\\"bestätigen\\\",\\\"eingang\\\",\\\"vorgangsnummer\\\",\\\"löschung\\\"],\\\"rejection_keywords\\\":[\\\"nicht möglich\\\",\\\"berechtigtes interesse\\\"],\\\"human_required_keywords\\\":[\\\"ausweis\\\",\\\"personalausweis\\\",\\\"identitätsnachweis\\\"]},\\\"added_date\\\":\\\"2025-05-21\\\",\\\"status\\\":\\\"active\\\",\\\"notes\\\":\\\"CRIF GmbH (formerly Bürgel Wirtschaftsinformationen) is a major German\\\\ncredit reference agency, now part of the Italian CRIF Group. They provide\\\\ncredit scores and consumer data to banks, insurers, and landlords.\\\\nGeburtsdatum = date of birth, required for identity matching.\\\\n\\\"},{\\\"id\\\":\\\"liveramp-eu\\\",\\\"name\\\":\\\"LiveRamp (EU)\\\",\\\"website\\\":\\\"https://liveramp.com\\\",\\\"category\\\":\\\"marketing\\\",\\\"jurisdictions\\\":[\\\"EU\\\",\\\"DE\\\",\\\"FR\\\",\\\"GB\\\"],\\\"laws\\\":[\\\"GDPR\\\"],\\\"data_sensitivity\\\":4,\\\"priority\\\":\\\"high\\\",\\\"opt_out\\\":[{\\\"type\\\":\\\"email\\\",\\\"endpoint\\\":\\\"GDPR@liveramp.com\\\",\\\"template\\\":\\\"gdpr-art17\\\",\\\"locale\\\":\\\"en\\\",\\\"required_fields\\\":[\\\"full_name\\\",\\\"email\\\"],\\\"supports_suppression\\\":true,\\\"expected_response_days\\\":30},{\\\"type\\\":\\\"web_form\\\",\\\"url\\\":\\\"https://liveramp.com/opt_out/\\\",\\\"form_spec\\\":{\\\"steps\\\":[{\\\"goto\\\":\\\".\\\"},{\\\"fill\\\":{\\\"input[name=email]\\\":\\\"${email}\\\"}},{\\\"click\\\":\\\"button[type=submit]\\\"},{\\\"wait_for\\\":\\\".success\\\"},{\\\"screenshot\\\":\\\"result\\\"}],\\\"timeout_seconds\\\":30,\\\"rate_limit_delay\\\":1}}],\\\"verification\\\":{\\\"ack_keywords\\\":[\\\"opt-out\\\",\\\"received\\\",\\\"suppressed\\\"],\\\"rejection_keywords\\\":[\\\"not found\\\",\\\"already opted out\\\"],\\\"human_required_keywords\\\":[\\\"additional information\\\"]},\\\"added_date\\\":\\\"2025-05-21\\\",\\\"status\\\":\\\"active\\\",\\\"notes\\\":\\\"LiveRamp's EU operations are subject to GDPR. The GDPR Art. 17 email\\\\nchannel provides stronger deletion rights than the web opt-out. Send to\\\\nGDPR@liveramp.com for the formal erasure request. LiveRamp EU is\\\\nincorporated in Ireland.\\\\n\\\"},{\\\"id\\\":\\\"oracle-data-cloud-eu\\\",\\\"name\\\":\\\"Oracle Data Cloud (EU)\\\",\\\"website\\\":\\\"https://www.oracle.com/data-cloud\\\",\\\"category\\\":\\\"marketing\\\",\\\"jurisdictions\\\":[\\\"DE\\\",\\\"IE\\\",\\\"NL\\\",\\\"EU\\\"],\\\"laws\\\":[\\\"GDPR\\\"],\\\"data_sensitivity\\\":5,\\\"priority\\\":\\\"high\\\",\\\"opt_out\\\":[{\\\"type\\\":\\\"email\\\",\\\"endpoint\\\":\\\"privacy@oracle.com\\\",\\\"template\\\":\\\"gdpr-art17\\\",\\\"locale\\\":\\\"en\\\",\\\"required_fields\\\":[\\\"full_name\\\",\\\"email\\\"],\\\"supports_suppression\\\":true,\\\"expected_response_days\\\":30}],\\\"verification\\\":{\\\"ack_keywords\\\":[\\\"received\\\",\\\"request id\\\"],\\\"rejection_keywords\\\":[\\\"cannot verify\\\"],\\\"human_required_keywords\\\":[\\\"additional verification\\\"]},\\\"added_date\\\":\\\"2025-05-21\\\",\\\"status\\\":\\\"active\\\"},{\\\"id\\\":\\\"schober-eu\\\",\\\"name\\\":\\\"Schober Information Group\\\",\\\"website\\\":\\\"https://www.schober.de\\\",\\\"category\\\":\\\"marketing\\\",\\\"jurisdictions\\\":[\\\"DE\\\",\\\"AT\\\",\\\"CH\\\",\\\"EU\\\"],\\\"laws\\\":[\\\"GDPR\\\"],\\\"data_sensitivity\\\":3,\\\"priority\\\":\\\"medium\\\",\\\"opt_out\\\":[{\\\"type\\\":\\\"email\\\",\\\"endpoint\\\":\\\"datenschutz@schober.de\\\",\\\"template\\\":\\\"gdpr-art17\\\",\\\"locale\\\":\\\"de\\\",\\\"required_fields\\\":[\\\"full_name\\\",\\\"address\\\",\\\"email\\\"],\\\"supports_suppression\\\":true,\\\"expected_response_days\\\":30}],\\\"verification\\\":{\\\"ack_keywords\\\":[\\\"bestätigen\\\",\\\"widerspruch\\\",\\\"löschung\\\"],\\\"rejection_keywords\\\":[\\\"nicht möglich\\\"],\\\"human_required_keywords\\\":[\\\"rückfragen\\\",\\\"identitätsnachweis\\\"]},\\\"added_date\\\":\\\"2025-05-21\\\",\\\"status\\\":\\\"active\\\",\\\"notes\\\":\\\"Schober is a German-speaking direct marketing data and address broker\\\\noperating in DE, AT, and CH. They supply address lists and consumer\\\\nsegment data to direct marketers and publishers.\\\\n\\\"},{\\\"id\\\":\\\"schufa-de\\\",\\\"name\\\":\\\"SCHUFA Holding AG\\\",\\\"website\\\":\\\"https://www.schufa.de\\\",\\\"category\\\":\\\"credit\\\",\\\"jurisdictions\\\":[\\\"DE\\\",\\\"EU\\\"],\\\"laws\\\":[\\\"GDPR\\\"],\\\"data_sensitivity\\\":5,\\\"priority\\\":\\\"high\\\",\\\"opt_out\\\":[{\\\"type\\\":\\\"email\\\",\\\"endpoint\\\":\\\"datenschutz@schufa.de\\\",\\\"template\\\":\\\"gdpr-art17\\\",\\\"locale\\\":\\\"de\\\",\\\"required_fields\\\":[\\\"full_name\\\",\\\"address\\\",\\\"email\\\",\\\"date_of_birth\\\"],\\\"supports_suppression\\\":false,\\\"expected_response_days\\\":30}],\\\"verification\\\":{\\\"ack_keywords\\\":[\\\"bestätigen\\\",\\\"erhalten\\\",\\\"vorgangsnummer\\\"],\\\"rejection_keywords\\\":[\\\"nicht verifizieren\\\",\\\"weitere Angaben\\\"],\\\"human_required_keywords\\\":[\\\"ausweis\\\",\\\"identitätsnachweis\\\"]},\\\"added_date\\\":\\\"2025-05-21\\\",\\\"status\\\":\\\"active\\\"},{\\\"id\\\":\\\"zeotap-eu\\\",\\\"name\\\":\\\"Zeotap GmbH\\\",\\\"website\\\":\\\"https://zeotap.com\\\",\\\"category\\\":\\\"marketing\\\",\\\"jurisdictions\\\":[\\\"DE\\\",\\\"EU\\\"],\\\"laws\\\":[\\\"GDPR\\\"],\\\"data_sensitivity\\\":4,\\\"priority\\\":\\\"medium\\\",\\\"opt_out\\\":[{\\\"type\\\":\\\"email\\\",\\\"endpoint\\\":\\\"privacy@zeotap.com\\\",\\\"template\\\":\\\"gdpr-art17\\\",\\\"locale\\\":\\\"en\\\",\\\"required_fields\\\":[\\\"full_name\\\",\\\"email\\\"],\\\"supports_suppression\\\":true,\\\"expected_response_days\\\":30},{\\\"type\\\":\\\"web_form\\\",\\\"url\\\":\\\"https://zeotap.com/privacy/\\\",\\\"form_spec\\\":{\\\"steps\\\":[{\\\"goto\\\":\\\".\\\"},{\\\"fill\\\":{\\\"input[name=email]\\\":\\\"${email}\\\",\\\"input[name=name]\\\":\\\"${full_name}\\\"}},{\\\"click\\\":\\\"button[type=submit]\\\"},{\\\"wait_for\\\":\\\".success\\\"},{\\\"screenshot\\\":\\\"result\\\"}],\\\"timeout_seconds\\\":30,\\\"rate_limit_delay\\\":1.5}}],\\\"verification\\\":{\\\"ack_keywords\\\":[\\\"received\\\",\\\"opt-out\\\",\\\"request\\\"],\\\"rejection_keywords\\\":[\\\"not found\\\",\\\"cannot process\\\"],\\\"human_required_keywords\\\":[\\\"additional information\\\"]},\\\"added_date\\\":\\\"2025-05-21\\\",\\\"source\\\":\\\"California Data Broker Registry\\\",\\\"status\\\":\\\"active\\\",\\\"notes\\\":\\\"Zeotap is a Berlin-based customer intelligence platform (CDP) providing\\\\nidentity resolution and audience data to advertisers and publishers across\\\\nthe EU. They operate the zeotap ID+ identity framework.\\\\n\\\"}],\\\"count\\\":13,\\\"filters\\\":{\\\"include_disabled\\\":false,\\\"status\\\":\\\"active\\\"},\\\"schema_version\\\":1}\",\"type\":\"text\"}]},\"id\":1}\n","error":false},{"name":"list-brokers-empty","tool":"list_brokers","arguments":{"jurisdiction":"zz-not-a-region"},"response":"{\"jsonrpc\":\"2.0\",\"result\":{\"content\":[{\"text\":\"{\\\"brokers\\\":[],\\\"count\\\":0,\\\"filters\\\":{\\\"include_disabled\\\":false,\\\"status\\\":\\\"active\\\"},\\\"schema_version\\\":1}\",\"type\":\"text\"}]},\"id\":1}\n","error":false},{"name":"dashboard-empty-html","tool":"generate_dashboard","arguments":{"auto_refresh":0},"response":"{\"jsonrpc\":\"2.0\",\"result\":{\"content\":[{\"text\":\"{\\\"campaigns\\\":null,\\\"dashboard\\\":\\\"\\\\u003c!DOCTYPE html\\\\u003e\\\\n\\\\u003chtml lang=\\\\\\\"en\\\\\\\"\\\\u003e\\\\n\\\\u003chead\\\\u003e\\\\n\\\\u003cmeta charset=\\\\\\\"UTF-8\\\\\\\"\\\\u003e\\\\n\\\\u003cmeta name=\\\\\\\"viewport\\\\\\\" content=\\\\\\\"width=device-width, initial-scale=1.0\\\\\\\"\\\\u003e\\\\n\\\\u003ctitle\\\\u003eSymaira EraseMe Dashboard\\\\u003c/title\\\\u003e\\\\n\\\\u003c!-- Load Roboto Flex variable font from Google Fonts --\\\\u003e\\\\n\\\\u003clink rel=\\\\\\\"preconnect\\\\\\\" href=\\\\\\\"https://fonts.googleapis.com\\\\\\\"\\\\u003e\\\\n\\\\u003clink rel=\\\\\\\"preconnect\\\\\\\" href=\\\\\\\"https://fonts.gstatic.com\\\\\\\" crossorigin\\\\u003e\\\\n\\\\u003clink href=\\\\\\\"https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wdth,wght@8..144,25..151,100..1000\\\\u0026display=swap\\\\\\\" rel=\\\\\\\"stylesheet\\\\\\\"\\\\u003e\\\\n\\\\u003cstyle\\\\u003e\\\\n/* Reset and Font system */\\\\n*, *::before, *::after {\\\\n  box-sizing: border-box;\\\\n  margin: 0;\\\\n  padding: 0;\\\\n}\\\\n\\\\n:root {\\\\n  /* Symaira brand design tokens */\\\\n  --bg-dark: #0D0C0A;\\\\n  --bg-darker: #070605;\\\\n  --bg-card: rgba(18, 17, 14, 0.65);\\\\n  --bg-card-hover: rgba(26, 24, 20, 0.85);\\\\n  \\\\n  --gold-primary: #E5C397;\\\\n  --gold-secondary: #F8E6CD;\\\\n  --gold-shadow: #C29965;\\\\n  \\\\n  --ice-primary: #EEDCC4;\\\\n  --ice-secondary: #D4B285;\\\\n  \\\\n  --text-primary: #F5F4F0;\\\\n  --text-secondary: #B5AEA5;\\\\n  --text-muted: #6E6860;\\\\n  \\\\n  --border-glass: rgba(255, 255, 255, 0.05);\\\\n  --border-glass-hover: rgba(229, 195, 151, 0.18);\\\\n  \\\\n  --shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);\\\\n  --transition-smooth: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);\\\\n  --transition-fast: all 0.15s ease;\\\\n\\\\n  /* Status Colors */\\\\n  --color-confirmed: #A7F3D0;\\\\n  --bg-confirmed: rgba(6, 78, 59, 0.5);\\\\n  --border-confirmed: rgba(16, 185, 129, 0.3);\\\\n\\\\n  --color-pending: #FDE68A;\\\\n  --bg-pending: rgba(120, 53, 15, 0.5);\\\\n  --border-pending: rgba(245, 158, 11, 0.3);\\\\n\\\\n  --color-rejected: #FCA5A5;\\\\n  --bg-rejected: rgba(92, 29, 29, 0.5);\\\\n  --border-rejected: rgba(239, 68, 68, 0.3);\\\\n\\\\n  --color-overdue: #FECACA;\\\\n  --bg-overdue: rgba(127, 29, 29, 0.6);\\\\n  --border-overdue: rgba(239, 68, 68, 0.4);\\\\n\\\\n  --color-planned: #DBEAFE;\\\\n  --bg-planned: rgba(30, 58, 138, 0.4);\\\\n  --border-planned: rgba(59, 130, 246, 0.3);\\\\n}\\\\n\\\\n@media (prefers-color-scheme: dark) {\\\\n  :root {\\\\n    --bg-dark: #0D0C0A;\\\\n  }\\\\n}\\\\n\\\\nbody {\\\\n  font-family: 'Roboto Flex', -apple-system, BlinkMacSystemFont, \\\\\\\"Segoe UI\\\\\\\", sans-serif;\\\\n  background-color: var(--bg-dark);\\\\n  color: var(--text-primary);\\\\n  line-height: 1.6;\\\\n  padding: 40px 20px;\\\\n  position: relative;\\\\n  min-height: 100vh;\\\\n  overflow-x: hidden;\\\\n  -webkit-font-smoothing: antialiased;\\\\n\\\\n  /* Blueprint Grid Background */\\\\n  background-image: radial-gradient(rgba(229, 195, 151, 0.02) 1px, transparent 1px);\\\\n  background-size: 24px 24px;\\\\n}\\\\n\\\\n/* Ambient glow blobs */\\\\n.ambient-glow {\\\\n  position: fixed;\\\\n  border-radius: 50%;\\\\n  filter: blur(140px);\\\\n  z-index: 0;\\\\n  pointer-events: none;\\\\n  opacity: 0.6;\\\\n}\\\\n\\\\n.glow-top-right {\\\\n  top: -150px;\\\\n  right: -100px;\\\\n  width: 50vw;\\\\n  height: 50vw;\\\\n  background: radial-gradient(circle, rgba(229, 195, 151, 0.06) 0%, transparent 70%);\\\\n}\\\\n\\\\n.glow-bottom-left {\\\\n  bottom: -200px;\\\\n  left: -150px;\\\\n  width: 45vw;\\\\n  height: 45vw;\\\\n  background: radial-gradient(circle, rgba(212, 178, 133, 0.04) 0%, transparent 70%);\\\\n}\\\\n\\\\n.container {\\\\n  max-width: 1200px;\\\\n  margin: 0 auto;\\\\n  position: relative;\\\\n  z-index: 1;\\\\n}\\\\n\\\\n/* Header design */\\\\nheader {\\\\n  margin-bottom: 40px;\\\\n  display: flex;\\\\n  justify-content: space-between;\\\\n  align-items: flex-end;\\\\n  border-bottom: 1px solid var(--border-glass);\\\\n  padding-bottom: 24px;\\\\n}\\\\n\\\\nh1 {\\\\n  font-size: 2.25rem;\\\\n  font-weight: 800;\\\\n  letter-spacing: -0.03em;\\\\n  background: linear-gradient(135deg, var(--gold-secondary) 30%, var(--gold-primary) 100%);\\\\n  -webkit-background-clip: text;\\\\n  -webkit-text-fill-color: transparent;\\\\n  margin-bottom: 4px;\\\\n}\\\\n\\\\n.subtitle {\\\\n  color: var(--text-secondary);\\\\n  font-size: 0.9rem;\\\\n}\\\\n\\\\n.last-updated {\\\\n  font-size: 0.8rem;\\\\n  color: var(--text-muted);\\\\n  text-align: right;\\\\n}\\\\n\\\\n.brand-badge {\\\\n  display: inline-block;\\\\n  background: rgba(229, 195, 151, 0.1);\\\\n  border: 1px solid var(--gold-primary);\\\\n  color: var(--gold-primary);\\\\n  font-size: 0.65rem;\\\\n  font-weight: 700;\\\\n  text-transform: uppercase;\\\\n  letter-spacing: 0.1em;\\\\n  padding: 2px 8px;\\\\n  border-radius: 4px;\\\\n  margin-bottom: 8px;\\\\n}\\\\n\\\\n/* Glassmorphism Cards */\\\\n.card {\\\\n  background: var(--bg-card);\\\\n  backdrop-filter: blur(16px);\\\\n  -webkit-backdrop-filter: blur(16px);\\\\n  border: 1px solid var(--border-glass);\\\\n  border-radius: 12px;\\\\n  padding: 24px;\\\\n  box-shadow: var(--shadow);\\\\n  transition: var(--transition-smooth);\\\\n}\\\\n\\\\n.card:hover {\\\\n  border-color: var(--border-glass-hover);\\\\n  box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.6);\\\\n}\\\\n\\\\n/* Summary Grid styling */\\\\n.summary-grid {\\\\n  display: grid;\\\\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\\\\n  gap: 16px;\\\\n  margin-bottom: 40px;\\\\n}\\\\n\\\\n.summary-card {\\\\n  text-align: left;\\\\n  display: flex;\\\\n  flex-direction: column;\\\\n  justify-content: space-between;\\\\n  min-height: 110px;\\\\n}\\\\n\\\\n.summary-card .count {\\\\n  font-size: 2.25rem;\\\\n  font-weight: 800;\\\\n  line-height: 1;\\\\n  letter-spacing: -0.02em;\\\\n  margin-bottom: 8px;\\\\n}\\\\n\\\\n.summary-card .label {\\\\n  font-size: 0.75rem;\\\\n  font-weight: 700;\\\\n  color: var(--text-secondary);\\\\n  text-transform: uppercase;\\\\n  letter-spacing: 0.08em;\\\\n}\\\\n\\\\n.summary-card.total .count { color: var(--text-primary); }\\\\n.summary-card.pending .count { color: var(--gold-primary); }\\\\n.summary-card.confirmed .count { color: var(--color-confirmed); }\\\\n.summary-card.rejected .count { color: var(--color-rejected); }\\\\n.summary-card.overdue .count { color: var(--color-overdue); }\\\\n\\\\n/* Section Headers */\\\\n.section-title-bar {\\\\n  display: flex;\\\\n  justify-content: space-between;\\\\n  align-items: center;\\\\n  margin-bottom: 16px;\\\\n  gap: 16px;\\\\n  flex-wrap: wrap;\\\\n}\\\\n\\\\n.section-title {\\\\n  font-size: 1.25rem;\\\\n  font-weight: 700;\\\\n  color: var(--gold-secondary);\\\\n  letter-spacing: -0.01em;\\\\n}\\\\n\\\\n.section {\\\\n  margin-bottom: 48px;\\\\n}\\\\n\\\\n/* Status Breakdown Chart */\\\\n.chart-container {\\\\n  display: flex;\\\\n  flex-direction: column;\\\\n  gap: 12px;\\\\n}\\\\n\\\\n.chart-bar-row {\\\\n  display: flex;\\\\n  align-items: center;\\\\n  gap: 16px;\\\\n  font-size: 0.85rem;\\\\n}\\\\n\\\\n.chart-bar-label {\\\\n  width: 120px;\\\\n  color: var(--text-secondary);\\\\n  font-weight: 600;\\\\n}\\\\n\\\\n.chart-bar-wrapper {\\\\n  flex-grow: 1;\\\\n  background: rgba(255, 255, 255, 0.02);\\\\n  border: 1px solid var(--border-glass);\\\\n  height: 24px;\\\\n  border-radius: 12px;\\\\n  overflow: hidden;\\\\n  position: relative;\\\\n}\\\\n\\\\n.chart-bar-fill {\\\\n  height: 100%;\\\\n  border-radius: 11px;\\\\n  transition: width 1s ease-out;\\\\n  position: relative;\\\\n}\\\\n\\\\n.chart-bar-fill.planned { background: linear-gradient(90deg, rgba(30,58,138,0.7), rgba(59,130,246,0.8)); }\\\\n.chart-bar-fill.sent { background: linear-gradient(90deg, rgba(110,104,96,0.5), rgba(181,174,165,0.7)); }\\\\n.chart-bar-fill.awaiting { background: linear-gradient(90deg, rgba(120,53,15,0.7), rgba(245,158,11,0.8)); }\\\\n.chart-bar-fill.confirmed { background: linear-gradient(90deg, rgba(6,78,59,0.7), rgba(16,185,129,0.8)); }\\\\n.chart-bar-fill.rejected { background: linear-gradient(90deg, rgba(92,29,29,0.7), rgba(239,68,68,0.8)); }\\\\n.chart-bar-fill.overdue { background: linear-gradient(90deg, rgba(127,29,29,0.8), rgba(239,68,68,0.9)); }\\\\n\\\\n.chart-bar-value {\\\\n  position: absolute;\\\\n  right: 12px;\\\\n  top: 50%;\\\\n  transform: translateY(-50%);\\\\n  font-weight: 700;\\\\n  font-size: 0.75rem;\\\\n  color: var(--text-primary);\\\\n}\\\\n\\\\n/* Tables styling */\\\\n.table-wrap {\\\\n  overflow-x: auto;\\\\n  border-radius: 8px;\\\\n  border: 1px solid var(--border-glass);\\\\n  background: rgba(7, 6, 5, 0.3);\\\\n}\\\\n\\\\ntable {\\\\n  width: 100%;\\\\n  border-collapse: collapse;\\\\n  font-size: 0.85rem;\\\\n  text-align: left;\\\\n}\\\\n\\\\nth, td {\\\\n  padding: 14px 18px;\\\\n  border-bottom: 1px solid var(--border-glass);\\\\n}\\\\n\\\\nth {\\\\n  font-weight: 700;\\\\n  color: var(--text-secondary);\\\\n  font-size: 0.7rem;\\\\n  text-transform: uppercase;\\\\n  letter-spacing: 0.08em;\\\\n  background: rgba(255, 255, 255, 0.01);\\\\n}\\\\n\\\\ntr:last-child td {\\\\n  border-bottom: none;\\\\n}\\\\n\\\\ntr:hover td {\\\\n  background: rgba(255, 255, 255, 0.015);\\\\n}\\\\n\\\\n/* Status Badges */\\\\n.badge {\\\\n  display: inline-flex;\\\\n  align-items: center;\\\\n  padding: 3px 10px;\\\\n  border-radius: 20px;\\\\n  font-size: 0.7rem;\\\\n  font-weight: 700;\\\\n  text-transform: uppercase;\\\\n  letter-spacing: 0.03em;\\\\n  border: 1px solid transparent;\\\\n}\\\\n\\\\n.badge-green {\\\\n  background: var(--bg-confirmed);\\\\n  color: var(--color-confirmed);\\\\n  border-color: var(--border-confirmed);\\\\n}\\\\n\\\\n.badge-yellow {\\\\n  background: var(--bg-pending);\\\\n  color: var(--color-pending);\\\\n  border-color: var(--border-pending);\\\\n}\\\\n\\\\n.badge-red {\\\\n  background: var(--bg-rejected);\\\\n  color: var(--color-rejected);\\\\n  border-color: var(--border-rejected);\\\\n}\\\\n\\\\n.badge-blue {\\\\n  background: var(--bg-planned);\\\\n  color: var(--color-planned);\\\\n  border-color: var(--border-planned);\\\\n}\\\\n\\\\n.badge-gray {\\\\n  background: rgba(110, 104, 96, 0.25);\\\\n  color: var(--text-secondary);\\\\n  border-color: rgba(255, 255, 255, 0.05);\\\\n}\\\\n\\\\n/* Interactive Search \\\\u0026 Filter Controls */\\\\n.filter-controls {\\\\n  display: flex;\\\\n  gap: 12px;\\\\n  align-items: center;\\\\n  flex-wrap: wrap;\\\\n}\\\\n\\\\n.search-input-wrapper {\\\\n  position: relative;\\\\n}\\\\n\\\\n.search-input {\\\\n  background: rgba(7, 6, 5, 0.5);\\\\n  border: 1px solid var(--border-glass);\\\\n  color: var(--text-primary);\\\\n  padding: 8px 14px;\\\\n  border-radius: 8px;\\\\n  font-size: 0.85rem;\\\\n  outline: none;\\\\n  width: 240px;\\\\n  font-family: inherit;\\\\n  transition: var(--transition-fast);\\\\n}\\\\n\\\\n.search-input:focus {\\\\n  border-color: var(--gold-primary);\\\\n  box-shadow: 0 0 0 2px rgba(229, 195, 151, 0.15);\\\\n}\\\\n\\\\n.filter-btn-group {\\\\n  display: flex;\\\\n  background: rgba(7, 6, 5, 0.4);\\\\n  border: 1px solid var(--border-glass);\\\\n  padding: 3px;\\\\n  border-radius: 8px;\\\\n}\\\\n\\\\n.filter-btn {\\\\n  background: transparent;\\\\n  border: none;\\\\n  color: var(--text-secondary);\\\\n  padding: 6px 12px;\\\\n  border-radius: 6px;\\\\n  font-size: 0.8rem;\\\\n  font-weight: 600;\\\\n  cursor: pointer;\\\\n  transition: var(--transition-fast);\\\\n  font-family: inherit;\\\\n}\\\\n\\\\n.filter-btn:hover {\\\\n  color: var(--text-primary);\\\\n}\\\\n\\\\n.filter-btn.active {\\\\n  background: rgba(229, 195, 151, 0.12);\\\\n  color: var(--gold-primary);\\\\n}\\\\n\\\\n/* Broker Grid Layout */\\\\n.broker-grid {\\\\n  display: grid;\\\\n  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\\\\n  gap: 12px;\\\\n}\\\\n\\\\n.broker-card {\\\\n  background: var(--bg-card);\\\\n  border: 1px solid var(--border-glass);\\\\n  border-radius: 10px;\\\\n  padding: 16px;\\\\n  display: flex;\\\\n  flex-direction: column;\\\\n  justify-content: space-between;\\\\n  gap: 12px;\\\\n  transition: var(--transition-smooth);\\\\n}\\\\n\\\\n.broker-card:hover {\\\\n  border-color: var(--border-glass-hover);\\\\n  transform: translateY(-2px);\\\\n}\\\\n\\\\n.broker-card-top {\\\\n  display: flex;\\\\n  justify-content: space-between;\\\\n  align-items: flex-start;\\\\n}\\\\n\\\\n.broker-name {\\\\n  font-weight: 700;\\\\n  font-size: 0.95rem;\\\\n  color: var(--gold-secondary);\\\\n  letter-spacing: -0.01em;\\\\n}\\\\n\\\\n.broker-stats-container {\\\\n  display: flex;\\\\n  flex-wrap: wrap;\\\\n  gap: 6px;\\\\n}\\\\n\\\\n.stat-tag {\\\\n  font-size: 0.65rem;\\\\n  font-weight: 700;\\\\n  padding: 2px 6px;\\\\n  border-radius: 4px;\\\\n  background: rgba(255,255,255,0.02);\\\\n  border: 1px solid var(--border-glass);\\\\n  color: var(--text-secondary);\\\\n}\\\\n\\\\n.stat-tag.confirmed { color: var(--color-confirmed); }\\\\n.stat-tag.pending { color: var(--color-pending); }\\\\n.stat-tag.rejected { color: var(--color-rejected); }\\\\n.stat-tag.overdue { color: var(--color-overdue); }\\\\n\\\\n/* Timeline design */\\\\n.timeline {\\\\n  display: flex;\\\\n  flex-direction: column;\\\\n  gap: 12px;\\\\n}\\\\n\\\\n.timeline-item {\\\\n  display: flex;\\\\n  gap: 16px;\\\\n  padding: 12px 16px;\\\\n  background: rgba(7, 6, 5, 0.25);\\\\n  border: 1px solid var(--border-glass);\\\\n  border-radius: 8px;\\\\n  align-items: center;\\\\n}\\\\n\\\\n.timeline-time {\\\\n  width: 140px;\\\\n  color: var(--text-muted);\\\\n  font-size: 0.75rem;\\\\n  font-weight: 600;\\\\n}\\\\n\\\\n.timeline-badge-wrap {\\\\n  width: 130px;\\\\n}\\\\n\\\\n.timeline-content {\\\\n  flex-grow: 1;\\\\n  font-size: 0.85rem;\\\\n}\\\\n\\\\n.timeline-broker {\\\\n  color: var(--gold-primary);\\\\n  font-weight: 600;\\\\n}\\\\n\\\\n.timeline-source {\\\\n  font-size: 0.75rem;\\\\n  color: var(--text-muted);\\\\n  text-align: right;\\\\n  width: 100px;\\\\n}\\\\n\\\\n#no-results-msg {\\\\n  grid-column: 1 / -1;\\\\n  text-align: center;\\\\n  padding: 40px;\\\\n  color: var(--text-muted);\\\\n  background: rgba(7, 6, 5, 0.2);\\\\n  border: 1px dashed var(--border-glass);\\\\n  border-radius: 8px;\\\\n  display: none;\\\\n}\\\\n\\\\n/* Custom scrollbars */\\\\n::-webkit-scrollbar {\\\\n  width: 8px;\\\\n  height: 8px;\\\\n}\\\\n::-webkit-scrollbar-track {\\\\n  background: var(--bg-darker);\\\\n}\\\\n::-webkit-scrollbar-thumb {\\\\n  background: var(--text-muted);\\\\n  border-radius: 4px;\\\\n}\\\\n::-webkit-scrollbar-thumb:hover {\\\\n  background: var(--text-secondary);\\\\n}\\\\n\\\\n@media (max-width: 768px) {\\\\n  header {\\\\n    flex-direction: column;\\\\n    align-items: flex-start;\\\\n    gap: 16px;\\\\n  }\\\\n  .last-updated {\\\\n    text-align: left;\\\\n  }\\\\n  .timeline-item {\\\\n    flex-direction: column;\\\\n    align-items: flex-start;\\\\n    gap: 8px;\\\\n    position: relative;\\\\n    padding-bottom: 30px;\\\\n  }\\\\n  .timeline-time {\\\\n    width: auto;\\\\n  }\\\\n  .timeline-source {\\\\n    position: absolute;\\\\n    botto